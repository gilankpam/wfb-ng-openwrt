#!/bin/sh
# procd command for mabur-relay. procd respawn re-runs THIS script, so every
# (re)start recreates mon0 and tunes it to the last channel the daemon
# confirmed (/tmp/mabur-relay.state) or the boot channel. POSIX sh only.
RELAY_CONF="${RELAY_CONF:-/etc/mabur-relay.conf}"
RELAY_STATE="${RELAY_STATE:-/tmp/mabur-relay.state}"
RELAY_BIN="${RELAY_BIN:-/usr/sbin/mabur-relay}"

PHY=phy0; MON=mon0; REG=US; TXPOWER=""
BOOT_CHANNEL=136; BOOT_SEC=HT40-; UDP_PORT=8310; WS_PORT=8311
[ -f "$RELAY_CONF" ] && . "$RELAY_CONF"

sec_code() { case "$1" in HT20) echo 0;; HT40+) echo 1;; HT40-) echo 2;; *) return 1;; esac; }

ch="$BOOT_CHANNEL"; sec="$BOOT_SEC"
if [ -f "$RELAY_STATE" ]; then
    read -r sch ssec < "$RELAY_STATE"
    case "$sch" in ''|*[!0-9]*) ;; *) sec_code "$ssec" >/dev/null && { ch="$sch"; sec="$ssec"; } ;; esac
fi

iw dev "$MON" del 2>/dev/null
iw reg set "$REG"
iw phy "$PHY" interface add "$MON" type monitor flags fcsfail otherbss || exit 1
ip link set "$MON" up || exit 1
iw dev "$MON" set channel "$ch" "$sec" || exit 1
# TX power on the phy: `iw dev <mon> set txpower` is EOPNOTSUPP on AR9344.
[ -n "$TXPOWER" ] && iw phy "$PHY" set txpower fixed "$TXPOWER"

exec "$RELAY_BIN" -i "$MON" -u "$UDP_PORT" -w "$WS_PORT" -c "$ch" -s "$(sec_code "$sec")" -S "$RELAY_STATE"
