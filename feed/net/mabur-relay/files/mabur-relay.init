#!/bin/sh /etc/rc.common
# procd service for mabur-relay: one respawning instance running the start
# wrapper, which (re)creates mon0 before exec'ing the daemon. Enabled at boot;
# the relay is passive until a client subscribes.
USE_PROCD=1
START=99
STOP=10

RELAY_CONF="${RELAY_CONF:-/etc/mabur-relay.conf}"

start_service() {
    procd_open_instance relay
    procd_set_param command /usr/libexec/mabur-relay-start
    # Retry forever, 5 s apart: bare `respawn` uses procd's finite retry
    # budget, which a mon0 del/add race or a transient iw failure can
    # exhaust and leave the relay dead until reboot.
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    MON=mon0
    [ -f "$RELAY_CONF" ] && . "$RELAY_CONF"
    iw dev "$MON" del 2>/dev/null
}

service_triggers() {
    procd_add_reload_trigger "mabur-relay"
}
