#!/bin/sh
# Stub iw for the relay loop tests. State lives in $IW_STUB_DIR.
D="${IW_STUB_DIR:?}"
cur() { [ -f "$D/cur" ] && cat "$D/cur" || echo "136 HT40-"; }
if [ "$1 $3 $4" = "dev set channel" ]; then
    mode=$(cat "$D/mode" 2>/dev/null || echo ok)
    echo "set $5 $6" >> "$D/calls"
    [ "$mode" = sleep ] && sleep 5
    [ "$mode" = fail ] && exit 1
    echo "$5 $6" > "$D/cur"
    exit 0
fi
if [ "$1 $3" = "dev info" ]; then
    set -- $(cur)
    ch=$1; sec=$2; f=$((5000 + 5 * ch))
    case "$sec" in HT20) w=20; c=$f;; HT40+) w=40; c=$((f + 10));; HT40-) w=40; c=$((f - 10));; esac
    printf 'Interface mon0\n\ttype monitor\n\tchannel %s (%s MHz), width: %s MHz, center1: %s MHz\n' "$ch" "$f" "$w" "$c"
    exit 0
fi
exit 2
